# The engine superuser. It provisions tenants and it runs the backup.
# NO TENANT EVER GETS THIS PASSWORD.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# The pgbouncer lookup role. It has no table rights. It exists only to run the
# auth_query SECURITY DEFINER function, so that neither door ever holds a copy
# of a tenant password.
#
# Both are read by initdb/01-engine-auth.sh, which runs ONLY on an empty
# volume. Changing them on an engine that already has data does nothing on its
# own — see the README, "Rotating the pgbouncer lookup role".
PGBOUNCER_AUTH_USER=pgbouncer_auth
PGBOUNCER_AUTH_PASSWORD=change-me

# --- pgadmin --------------------------------------------------------------

# The subdomain pgadmin answers on. It needs a DNS A record pointing at this
# host before traefik can issue a certificate for it.
PGADMIN_HOST=pgadmin.example.com

# The pgadmin login. This is the SECOND lock, behind the traefik basicauth.
PGADMIN_DEFAULT_EMAIL=user@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# The FIRST lock: a traefik basicauth middleware, which rejects a request
# before it reaches the pgadmin application at all.
#
# Generate with:  htpasswd -nbB <user> <password>
#
# THEN DOUBLE EVERY `$`. Compose expands `$` inside a value it reads from this
# file, so an unescaped bcrypt hash is SILENTLY TRUNCATED at its third `$` —
# `user:$2y$05$abc...` reaches traefik as `user:$2y$05`, and every login is
# rejected with nothing in any log to explain it.
#
#   htpasswd -nbB user secret | sed 's/\$/$$/g'
#
# So a real line looks like `user:$$2y$$05$$abc...`.
PGADMIN_BASIC_AUTH=user:$$2y$$05$$exampleexampleexampleexampleexampleexampleexampleexa

# The traefik certificate resolver that issues the pgadmin certificate. It is
# defined by the reverse proxy, not here, and it MUST match the name that proxy
# uses.
RESOLVER_NAME=myresolver

# --- Backup ---------------------------------------------------------------

# go-cron syntax. @daily is the law for every tenant.
BACKUP_SCHEDULE=@daily

# Databases the backup skips, comma separated. `postgres` holds the auth_query
# function and nothing else; the globals file and provisioning rebuild it, so
# an archive of it is noise. The templates are dropped by the query itself.
BACKUP_EXCLUDE_DATABASES=postgres

# The engine's own bucket, reached by an IAM user that can read and write it
# and NOTHING else.
# Required IAM actions: s3:PutObject, s3:GetObject, s3:ListBucket.
# Deliberately NOT granted: s3:DeleteObject. Retention is a 30-day S3 lifecycle
# rule on the bucket, so an engine that is compromised cannot erase its own
# backups, and a fault in the script cannot either.
S3_BUCKET=example-engine-backups
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# Every archive AND the globals file are encrypted with this, symmetrically.
# The globals file carries the SCRAM verifier of every tenant in one object, so
# it is as sensitive as the data.
# LOSE THIS AND EVERY ARCHIVE IS WASTE. Keep a copy in your private notes.
BACKUP_PASSPHRASE=change-me
